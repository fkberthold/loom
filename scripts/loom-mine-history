#!/usr/bin/env bash
# loom-mine-history — user-facing wrapper around the decision-archaeology
# history-miner engine (lib/loom-mine-history.sh).
#
# The engine harvests a repo's merged PRs + merge/squash commits + release
# tags, heuristically gates them, runs an LLM salience+draft pass behind a
# mandatory cost gate, and emits a manifest (drafts.jsonl + kg-triples.jsonl)
# to disk. The engine CANNOT file into MemPalace — MCP tools are not callable
# from bash. This wrapper owns repo + wing RESOLUTION and engine INVOCATION;
# the MCP palace filing belongs to skills/loom-mine-history/SKILL.md, which
# drives this wrapper through the locked two-pass cost gate (dry-run preview →
# user go-ahead → real pass) and then files the manifest.
#
# Design source: drawer_loom_decisions_e43e3693c8ee82e3bc6e34c6
# (loom/decisions wing). Tracks loom-bn7.4. Engine: loom-bn7.1.
#
# Usage:
#   scripts/loom-mine-history [--root <dir>] [--wing <name>] \
#       [--since=DATE] [--since-release=TAG] [--max-units=N] \
#       [--dry-run] [--model=MODEL] [--out <dir>]
#
#   --root <dir>          repo to mine (default: cwd's project root, which
#                         is the main checkout even from a worktree)
#   --wing <name>         MemPalace wing for filing. Rung 1 of the shared
#                         chain in lib/loom-wing-resolve.sh: --wing →
#                         mempalace.yaml → the constitution's `wing:` →
#                         basename VERBATIM (no `_`↔`-` subst, no
#                         case-fold) → the bd id prefix. Same chain
#                         scripts/loom-audit-resolve reads.
#   --since=DATE          only commits/PRs since DATE (git --since)
#   --since-release=TAG   only history after TAG
#   --max-units=N         cap survivors fed to the LLM pass
#   --dry-run             cost preview only; zero spend; NO manifest
#   --model=MODEL         claude model (engine default: a cheap tier)
#   --out <dir>           manifest output dir (REAL pass only; the skill
#                         passes a tmp dir). Ignored under --dry-run.
#
# Two-pass contract (enforced jointly with the skill):
#   - --dry-run invokes the engine with --dry-run and WITHOUT --out, so
#     zero LLM spend and no manifest written. Prints the cost preview.
#   - the real pass invokes the engine with --yes --out <dir>, writes the
#     manifest, AND writes <dir>/wing (single line) + echoes the resolved
#     wing — the engine emits no wing, the skill needs it for filing.
#
# Self-relative lib resolution (loom-0k0 pattern, see
# scripts/loom-print-deploy-hint): the worktree's wrapper always uses the
# worktree's lib; the installed wrapper uses the installed lib.

set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lib="$script_dir/../lib/loom-mine-history.sh"

if [ ! -f "$lib" ]; then
  echo "loom-mine-history: engine lib not found at $lib" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$lib"

# The shared wing resolver (loom-pc3x). LOOM_TEST_LIB_DIR first, so a
# test reads the tree it is editing; otherwise the same self-relative
# rule the engine lib above uses.
if [ -n "${LOOM_TEST_LIB_DIR:-}" ] && [ -f "$LOOM_TEST_LIB_DIR/loom-wing-resolve.sh" ]; then
  wing_lib="$LOOM_TEST_LIB_DIR/loom-wing-resolve.sh"
else
  wing_lib="$script_dir/../lib/loom-wing-resolve.sh"
fi
if [ ! -f "$wing_lib" ]; then
  echo "loom-mine-history: wing resolver not found at $wing_lib" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$wing_lib"

# --- Parse wrapper flags --------------------------------------------------
root=""
wing=""
out=""
dry_run=0
# Flags passed straight through to the engine.
passthru=()

while [ $# -gt 0 ]; do
  case "$1" in
    --root)            shift; root="${1:-}" ;;
    --root=*)          root="${1#--root=}" ;;
    --wing)            shift; wing="${1:-}" ;;
    --wing=*)          wing="${1#--wing=}" ;;
    --out)             shift; out="${1:-}" ;;
    --out=*)           out="${1#--out=}" ;;
    --dry-run)         dry_run=1 ;;
    --since|--since-release|--max-units|--model)
      # Two-token forms: keep both tokens together for the engine.
      flag="$1"; shift; passthru+=("$flag" "${1:-}") ;;
    --since=*|--since-release=*|--max-units=*|--model=*)
      passthru+=("$1") ;;
    *)
      echo "loom-mine-history: unrecognized argument '$1'" >&2
      exit 2 ;;
  esac
  shift
done

# --- Resolve repo ---------------------------------------------------------
# Precedence: --root override, else the shared root policy. A mine run
# started from inside a linked worktree belongs to the project, not to
# the worktree: the plain toplevel there is `agent-<hash>`, and filing
# 144 drawers into a wing named after a directory that will not exist
# next week is loom-kpke's harm with a new spelling (loom-l78w). An
# explicit --root is left exactly as the caller gave it.
if [ -n "$root" ]; then
  if [ ! -d "$root" ]; then
    echo "loom-mine-history: --root '$root' does not exist or is not a directory" >&2
    exit 2
  fi
  repo="$root"
else
  # The policy falls back to cwd outside a repo rather than answering
  # empty, so the "not a repo" case is caught here, before it, to keep
  # the message that names the actual cause.
  if ! git -C "$PWD" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "loom-mine-history: no --root given and cwd is not inside a git repository" >&2
    exit 2
  fi
  repo="$(loom_wing_project_root "$PWD")"
fi

# Validate the resolved repo is a git working tree (covers --root pointing
# at a real-but-non-git dir).
if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
  echo "loom-mine-history: '$repo' is not a git repository" >&2
  exit 2
fi
# Canonicalize so the wing basename is stable regardless of trailing slashes.
repo="$(cd "$repo" && pwd)"

# --- Resolve wing ---------------------------------------------------------
# One call into the shared chain (lib/loom-wing-resolve.sh). Reading the
# same chain scripts/loom-audit-resolve reads is what keeps the wing this
# miner FILES into equal to the wing /audit-project SEARCHES for citation
# drift. When the two derived it separately they drifted apart, which is
# loom-kpke.
#
# The chain is four rungs: an explicit --wing, then mempalace.yaml, then
# the constitution, then the basename. The bd id prefix is not one of
# them, for the reason loom-audit-resolve states: this wrapper always
# holds a repo root, so the basename always answers, and loom-6fyj
# dropped the rung under it that could never fire. Where the prefix and
# the directory name disagree the directory name is the one that names a
# live wing (loom-pc3x).
if [ -n "$wing" ]; then
  wing="$(loom_wing_resolve --root "$repo" --wing "$wing")"
else
  wing="$(loom_wing_resolve --root "$repo")"
fi

# --- Invoke the engine ----------------------------------------------------
if [ "$dry_run" -eq 1 ]; then
  # Cost-preview only: --dry-run, no --out → zero spend, no manifest.
  loom_mine_history "$repo" --wing="$wing" --dry-run "${passthru[@]}"
  rc=$?
  echo "(wing for filing: $wing)"
  exit "$rc"
fi

# Real pass: requires an output dir to receive the manifest.
if [ -z "$out" ]; then
  echo "loom-mine-history: real pass requires --out <dir> (the skill passes a tmp dir)" >&2
  exit 2
fi
mkdir -p "$out"

loom_mine_history "$repo" --wing="$wing" --yes --out "$out" "${passthru[@]}"
rc=$?

# The engine emits no wing; the wrapper surfaces it to the skill.
printf '%s\n' "$wing" > "$out/wing"
echo "(wing for filing: $wing)"

exit "$rc"
